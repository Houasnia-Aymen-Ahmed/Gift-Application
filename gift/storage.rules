rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Avatars live at avatars/{uid} — one image per user, keyed by their
    // own uid so two users can never collide on or overwrite each other's
    // picture. Any signed-in user can view an avatar (friends' avatars
    // render in the UI), but only the owner can write their own.
    match /avatars/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.uid == uid &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
